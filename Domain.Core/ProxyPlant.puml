        rectangle "REGIST(LOGIN,PSW, email)" as REGISTR
        rectangle "REgistTg(APPID,tgid)" as RegistrTGID
        rectangle "LOGIN(LOGIN,PSW)" as LOGIN
        rectangle "ForgotPSWEXIST?(email)" as CheckEXIST
        rectangle "ForgotPswChange(appid,psw)" as ChangePsw
        
        rectangle "SELECT(APPID)" as SELECTAPPID
        rectangle "Update(APPID, FriendUsername, FriendName, DateB, Interest, Pozh)" as Update
