            rectangle "связь appid - mail"  as MailC
            rectangle "связь appid - telegram"  as TgC
            rectangle "поздравление"  as Pozdrik
            rectangle "Аккаунты"  as Uers
        }
        rectangle "Щаблоны" as Templates{
            rectangle "шаблон для регистрации" as RegistTemp
            rectangle "шаблон для попдписи тг" as RegistTGTemp
            rectangle "шаблон для входа" as LoginTemnp
            rectangle "шаблон для проверка сущ" as CHExistTemp
            rectangle "шаблон для смены парол" as ChangePswTemp
            rectangle "шаблон - передача id" as AppidTemp
            rectangle "шаблон для add up" as ADDAndUpdateTemp
            rectangle "шаблон для del" as DeleteTemp
            
            
            
        }
