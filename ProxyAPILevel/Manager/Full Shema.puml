@startuml

skinparam dpi 150
skinparam padding 30
skinparam horizontalSpacing 50
skinparam verticalSpacing 50
skinparam linetype polyline

' --- Цветовая схема для разных категорий ---
skinparam component {
    BackgroundColor<<API>> LightBlue
    BackgroundColor<<Logic>> LightGreen
    BackgroundColor<<DB>> LightGray
    BackgroundColor<<Bots>> LightYellow
}

actor "Telegram Client" as UserTG
actor "Email" as EBOX
actor "Desktop or Web Client" as Client

rectangle "Система" {
    
    rectangle "Внешний интерфейс" {
        component "Gateway" as API <<API>>
    }

    rectangle "Бизнес-логика" {
        component "Friends" as CRUD <<Logic>>
        component "TG подписка" as TGSUB <<Logic>>
        component "Восстановление пароля" as Eforgot <<Logic>>
        component "Нейро заполнение" as Neyro <<Logic>>
    }

    rectangle "Аутентификация" {
        component "Auth" as Auth <<Logic>>
        component "Регистрация" as Registr <<Logic>>
    }

    rectangle "Боты" {
        component "Telegram-бот" as TelegramBot <<Bots>>
        component "Email-бот" as EmailBot <<Bots>>
    }

    rectangle "Хранение данных" {
        database "БД" as DB <<DB>>
        component "Прокси для БД" as DBProxy <<DB>>
    }
}

' --- Клиентские взаимодействия ---
Client -right-> API 

' --- Работа ботов ---
TelegramBot -down-> UserTG 
EmailBot -down-> EBOX 

' --- API и бизнес-логика ---
API -down-> CRUD
API -down-> TGSUB
API -down-> Eforgot
API -down-> Registr
API -down-> Neyro

' --- Взаимодействие с БД через прокси ---
CRUD -down-> DBProxy  
Auth -down-> DBProxy 
Registr -down-> DBProxy 
TGSUB -down-> DBProxy 
Eforgot -down-> DBProxy 
Neyro -down-> DBProxy 

DBProxy -down-> DB 

DBProxy -down->TelegramBot
DBProxy -down->EmailBot


@enduml
